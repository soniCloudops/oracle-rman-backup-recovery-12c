RUN {
    ALLOCATE CHANNEL ch1 DEVICE TYPE DISK;
    ALLOCATE CHANNEL ch2 DEVICE TYPE DISK;

    BACKUP AS COMPRESSED BACKUPSET
        ARCHIVELOG ALL
        NOT BACKED UP 1 TIMES
        FORMAT '/backup/rman/ARCH_%d_%T_%U'
        TAG 'ARCHIVELOG_DAILY';

    RELEASE CHANNEL ch1;
    RELEASE CHANNEL ch2;
}